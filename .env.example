APP_NAME="ArtaClean"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://artaclean.ir
APP_TIMEZONE=Asia/Tehran

# fa = Persian (RTL, default), en = English
APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database — MySQL 8
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artaclean
DB_USERNAME=artaclean
DB_PASSWORD=

# For a zero-dependency local run, swap the block above for:
# DB_CONNECTION=sqlite

# ---------------------------------------------------------------------------
# Redis — cache, session, queue
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
CACHE_PREFIX=artaclean

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
HORIZON_PREFIX=artaclean_horizon:

BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Search — Laravel Scout
# "database" needs nothing extra; "meilisearch" is the production choice.
# ---------------------------------------------------------------------------
SCOUT_DRIVER=database
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ---------------------------------------------------------------------------
# Object storage for images, catalogs and datasheets (S3 compatible:
# Arvan Cloud, Liara, MinIO, Backblaze B2, AWS S3 ...)
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=default
AWS_BUCKET=artaclean
AWS_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@artaclean.ir"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Storefront
# ---------------------------------------------------------------------------
SITE_PHONE="۰۲۱-۹۱۰۰۰۰۰۰"
SITE_WHATSAPP="989120000000"
SITE_EMAIL="info@artaclean.ir"
SITE_ADDRESS="تهران، خیابان آزادی، پلاک ۱"
SITE_INSTAGRAM="https://instagram.com/artaclean"
SITE_PRICES_PUBLIC=false

VITE_APP_NAME="${APP_NAME}"
